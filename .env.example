# Salin file ini menjadi .env untuk development lokal, lalu isi nilai di bawah.
# Saat hosting produksi (Render/Railway/PythonAnywhere), isi variabel yang sama
# ini lewat menu "Environment Variables" di dashboard hosting, JANGAN unggah file
# .env ke repository.

# Kunci rahasia Flask untuk session & CSRF. Ganti dengan string acak yang panjang.
# Bisa generate lewat: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# "production" saat sudah di-hosting dengan HTTPS, "development" saat di localhost
FLASK_ENV=development
FLASK_DEBUG=true

# Kredensial admin — WAJIB diganti dari nilai default sebelum hosting publik
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-yang-kuat

# Proteksi brute-force login sederhana
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10
